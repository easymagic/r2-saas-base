    {
      "name": "Threads",
      "description": "Order message threads. Requires `x-token` + `x-user-token`. `sender_id` is taken from the authenticated user.\n\nOn create: creates an in-app notification for the order owner. If the sender is not the order owner, also emails the customer via ThreadNotificationService.",
      "item": [
        {
          "name": "Create Thread",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  var json = pm.response.json();",
                  "  var thread = json.data && json.data.thread ? json.data.thread : (json.thread || null);",
                  "  if (thread && thread.id) {",
                  "    pm.collectionVariables.set('threadId', String(thread.id));",
                  "  }",
                  "  if (thread && thread.order_id) {",
                  "    pm.collectionVariables.set('orderId', String(thread.order_id));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-token", "value": "{{xToken}}" },
              { "key": "x-user-token", "value": "{{xUserToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "order_id", "value": "{{orderId}}", "type": "text" },
                { "key": "message", "value": "Hello, checking on my order.", "type": "text" },
                { "key": "attachment_url", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/v2/threads",
            "description": "POST /v2/threads\n\nBody (form-data): `order_id`, `message`, optional `attachment_url` file.\n`sender_id` = authenticated user.\n\nSide effects: in-app notification to order owner; email to customer when sender ≠ order owner.\nSaves `thread.id` → `threadId` on success."
          }
        },
        {
          "name": "List Threads For Order",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-token", "value": "{{xToken}}" },
              { "key": "x-user-token", "value": "{{xUserToken}}" }
            ],
            "url": "{{baseUrl}}/v2/threads/{{orderId}}",
            "description": "GET /v2/threads/{order_id}\n\nReturns all thread messages for the order (ordered by `created_at` ASC) plus `count`."
          }
        }
      ]
    },
