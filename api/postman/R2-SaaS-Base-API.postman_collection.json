    {
      "name": "Snappy Orders",
      "description": "Requires `x-token` + `x-user-token`.",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  var json = pm.response.json();",
                  "  var order = json.data && json.data.order ? json.data.order : (json.order || null);",
                  "  if (order && order.id) {",
                  "    pm.collectionVariables.set('orderId', String(order.id));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-token", "value": "{{xToken}}" },
              { "key": "x-user-token", "value": "{{xUserToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "link", "value": "https://store.example.com/item/1", "type": "text" },
                { "key": "description", "value": "Snappy order request", "type": "text" },
                { "key": "total_amount_usd", "value": "50", "type": "text" },
                { "key": "screen_shot1", "type": "file", "src": "" },
                { "key": "screen_shot2", "type": "file", "src": "" },
                { "key": "screen_shot3", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/v2/snappy-orders",
