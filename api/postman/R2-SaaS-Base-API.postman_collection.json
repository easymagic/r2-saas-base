    {
      "name": "Auth (Public)",
      "description": "Requires `x-token` only.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  var json = pm.response.json();",
                  "  var user = json.data && json.data.user ? json.data.user : (json.user || null);",
                  "  if (user && user.token) {",
                  "    pm.collectionVariables.set('xUserToken', user.token);",
                  "  }",
                  "  if (user && user.id) {",
                  "    pm.collectionVariables.set('userId', String(user.id));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-token", "value": "{{xToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/v2/auth/login",
            "description": "Saves `user.token` → `xUserToken` on success."
          }
        },
        {
          "name": "Register",
          "event": [
