    {
      "name": "Batches",
      "description": "Requires `x-token` + `x-user-token`.",
      "item": [
        {
          "name": "Create Batch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  var json = pm.response.json();",
                  "  var batch = json.data && json.data.batch ? json.data.batch : (json.batch || null);",
                  "  if (batch && batch.id) {",
                  "    pm.collectionVariables.set('batchId', String(batch.id));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-token", "value": "{{xToken}}" },
              { "key": "x-user-token", "value": "{{xUserToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Batch 1\",\n  \"description\": \"First order batch\"\n}"
            },
            "url": "{{baseUrl}}/v2/batches",
            "description": "Saves `batch.id` → `batchId` on success."
          }
        },
        {
          "name": "List Batches",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-token", "value": "{{xToken}}" },
              { "key": "x-user-token", "value": "{{xUserToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/batches",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "batches"],
              "query": [
                { "key": "id", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Remove Batch",
          "request": {
            "method": "DELETE",
            "header": [
