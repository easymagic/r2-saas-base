# API origin for browser requests (no trailing slash).
# Leave empty to use same-origin relative paths (/v2/..., /uploads/...).
API_BASE_URL=http://localhost:2020

# Legacy alias (still supported if API_BASE_URL is unset)
# VITE_API_BASE_URL=http://localhost:2020

# Static x-token header sent with API requests (Postman collection variable xToken)
X_TOKEN=1234567890
# Legacy aliases still supported:
# VITE_API_X_TOKEN=1234567890
# API_X_TOKEN=1234567890
