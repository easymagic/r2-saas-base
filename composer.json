{
    "name": "easymagic/r2-saas-base",
    "description": "R2 SaaS base with classic PHP web UI",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "r2-packages/framework": "dev-main"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t api api/router.php",
        "serve-api": "php -S localhost:8080 -t api api/router.php"
    },
    "minimum-stability": "stable"
}
